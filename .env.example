# Copy to .env and set real values. .env is gitignored.

# Postgres (warehouse + pgvector)
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=str_dw
# Host port; the container still listens on 5432
POSTGRES_PORT=5433

# Metabase (stores its own settings in a separate database on the same Postgres)
MB_DB_DBNAME=metabase
METABASE_PORT=3000
